# ── LLM & Embedding (lokal, Ollama) ──
OLLAMA_URL=http://ollama-host:11434
LLM_MODEL=qwen3:14b
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIM=1024                 # Matryoshka: 256/512/1024
SPARSE_MODEL=Qdrant/bm25
SPARSE_LANGUAGE=german
USE_COLBERT=false                  # optionales Late-Interaction-Reranking

# ── Retrieval / Hybrid ──
TOP_K_INITIAL=20
TOP_K_FINAL=5
FUSION=rrf                         # rrf | dbsf
USE_MMR=true
RERANKER=logprobs                  # logprobs | cross_encoder | cohere
USE_QUERY_TRANSFORM=false          # HyDE/Multi-Query (Latenz-Trade-off)
USE_ROUTER=true

# ── Confidence-Gate (Anti-Halluzination) ──
CONF_GREEN=0.7
CONF_YELLOW=0.4                    # < CONF_YELLOW → Refusal

# ── Indexierung ──
USE_CONTEXTUAL_RETRIEVAL=true
CHUNK_TARGET_TOKENS=512
CHUNK_MAX_TOKENS=768
CONTEXT_CONCURRENCY=4

# ── Extraction (Docling) ──
DOCLING_SERVE_URL=                 # leer = lokal; z.B. http://gpu-host:5001
DOCLING_OCR=true
DOCLING_TABLE_MODE=accurate        # fast | accurate
DOCLING_DO_FIGURES=true
BOILERPLATE_CLEAN=true             # Kopf-/Fusszeilen + Seitenzahlen entfernen

# ── Generierung ──
STREAMING=true
GEN_NUM_PREDICT=2048               # Grosszuegig: think-Block + sichtbare Antwort
GEN_TEMPERATURE=0.3
MEMORY_WINDOW=5
USE_SUMMARY_MEMORY=true
USE_GROUNDING_CHECK=true
GROUNDING_THRESHOLD=0.5

# ── Qdrant ──
QDRANT_URL=http://localhost:6335
QDRANT_COLLECTION=halle_wissen
QDRANT_QUANTIZATION=int8

# ── Compliance / Governance ──
AUDIT_LOG=true
ON_PREM=true
CONTACT_FALLBACK_URL=https://www.b-tu.de/fg-automatisierungstechnik/team/kontakt

# ── Observability ──
LOG_LEVEL=INFO
OTEL_ENABLED=true

# ── Crawler (SEKUNDÄR — Primärquelle sind lokale Dokumente in data/manual/) ──
CRAWLER_DOMAINS=b-tu.de
CRAWLER_RATE_LIMIT=1.0
CRAWLER_MAX_PAGES=2000

# ── API ──
API_PORT=8001
# API_BASE_URL wird automatisch aus API_PORT abgeleitet (http://localhost:{API_PORT}).
# Nur explizit setzen, wenn die API auf einem anderen Host laeuft (z.B. Docker).
# API_BASE_URL=http://api-host:8001
ADMIN_API_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:8501,http://localhost:3000
RATE_LIMIT_RPM=60

# ── Halle-Gehirn / Branding ──
BOT_NAME=Jarvis
PRIMARY_COLOR=#c41230              # MDZ-Rot (bei Bedarf BTU-Hausfarbe eintragen)
LANGUAGE=de
