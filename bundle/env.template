# ── Halle-Gehirn Standalone-Bundle ──
# Alle Werte sind hier ueberschreibbar; Details: .env.example im Quellrepo.
# Die drei externen Dienste MUESSEN erreichbar sein:

# ── LLM: Ollama ODER OpenAI-kompatibler Server (vLLM, TEI, GPU-Host ats0) ──
# LLM_BACKEND=openai setzt OPENAI_BASE_URL/OPENAI_API_KEY/OPENAI_MODEL voraus.
LLM_BACKEND=ollama
OLLAMA_URL=http://141.43.76.22:11434
LLM_MODEL=qwen3:14b
# ── Alternativ: OpenAI-kompatibles Backend ──
# OPENAI_BASE_URL=http://141.43.76.22:8080/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=

# ── Embeddings (dense) — ollama, openai oder fastembed (lokal) ──
# EMBEDDING_BACKEND=openai setzt EMBEDDING_OPENAI_BASE_URL voraus;
# EMBEDDING_DIM muss zum Qdrant-Index passen.
EMBEDDING_BACKEND=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIM=1024
# ── Alternativ: OpenAI-kompatibles Embedding-Backend ──
# EMBEDDING_OPENAI_BASE_URL=http://141.43.76.22:8081/v1
# EMBEDDING_OPENAI_API_KEY=
# EMBEDDING_OPENAI_MODEL=

# ── Qdrant (extern, enthaelt den Index halle_wissen) ──
QDRANT_URL=http://141.43.76.22:6335
QDRANT_COLLECTION=halle_wissen

# ── Docling Serve (extern — Extraktion/Ingestion im Bundle) ──
DOCLING_SERVE_URL=http://141.43.76.21:5001

# ── Statische Frontends (Chat "/", Wissensbestand "/admin/") ──
STATIC_DIR=static

# ── API ──
API_PORT=8001
CORS_ORIGINS=http://localhost:8001
ADMIN_API_KEY=change-me-in-production

# ── Reranker: logprobs benoetigt Ollama; "none" ohne LLM am schnellsten ──
RERANKER=logprobs
